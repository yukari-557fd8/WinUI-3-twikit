<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
        <RootNamespace>WinUI3Twikit</RootNamespace>
        <Platforms>x86;x64;ARM64</Platforms>
        <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
        <UseWinUI>true</UseWinUI>
        <Nullable>enable</Nullable>
        <AppxBundlePlatforms>x86;x64;arm64</AppxBundlePlatforms>

        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    </PropertyGroup>

    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>NU1701</NoWarn>
    </PropertyGroup>


    <ItemGroup>
      <Content Remove="TwitterIcon48.png" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="TwitterIcon48.ico" />
    </ItemGroup>


    <ItemGroup>
        <Manifest Include="$(ApplicationManifest)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="H.NotifyIcon.WinUI" Version="2.2.0" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
        <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    </ItemGroup>

    <!--
      twikit-dotnet（twikit の C# 移植。Python バックエンドの代わりに Bridge/ から直接呼び出す）。
      既定ではこのリポジトリの隣（..\twikit-dotnet）に clone されている前提。
      別の場所にある場合は環境変数 TWIKIT_DOTNET_DIR か MSBuild プロパティ TwikitDotnetDir で指定する。
    -->
    <PropertyGroup>
        <TwikitDotnetDir Condition="'$(TwikitDotnetDir)' == '' and '$(TWIKIT_DOTNET_DIR)' != ''">$([MSBuild]::EnsureTrailingSlash('$(TWIKIT_DOTNET_DIR)'))</TwikitDotnetDir>
        <TwikitDotnetDir Condition="'$(TwikitDotnetDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\twikit-dotnet\</TwikitDotnetDir>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(TwikitDotnetDir)src\Twikit\Twikit.csproj" />
    </ItemGroup>

    <!--
      単一 exe の publish 用（GitHub Actions の release ワークフローと同じ）:
        dotnet publish WinUI3Twikit.csproj -c Release -r win-x64 -p:Platform=x64 -p:PublishSingleFile=true
      Windows App SDK の SingleFile.targets が要求する設定。通常のビルドや MSIX パッケージには影響しない。
    -->
    <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
        <WindowsPackageType>None</WindowsPackageType>
        <EnableMsixTooling>true</EnableMsixTooling>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <SelfContained>true</SelfContained>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    </PropertyGroup>

    <!--
      単一 exe のリネーム対策。
      パッケージ化していない WinUI 3 アプリは、起動時に XAML のリソース索引を「<exe 名>.pri」から探し、
      無ければ resources.pri にフォールバックする。release ワークフローは exe を WinUI3Twikit-<タグ>-win-x64.exe に
      リネームして配布する（利用者が exe を改名することもある）ため、アプリの .pri を resources.pri としても同梱する。
      これが無いと、リネームした exe は起動直後に Microsoft.UI.Xaml.dll 内で 0xc000027b で落ちる。
    -->
    <Target Name="AddResourcesPriToPublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(WindowsPackageType)' == 'None'">
        <ItemGroup Condition="Exists('$(OutDir)$(TargetName).pri')">
            <ResolvedFileToPublish Include="$(OutDir)$(TargetName).pri" RelativePath="resources.pri" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

    <PropertyGroup Label="Globals">
      <WebView2DispatchAdapterNamespace>WinUI 3  Twitter</WebView2DispatchAdapterNamespace>
    </PropertyGroup>

    <!-- Publish Properties -->
    <PropertyGroup>
        <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
        <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>

        <!-- WinUI 3 は Trim と相性が悪いので無効化 -->
        <PublishTrimmed>false</PublishTrimmed>

        <!-- AOT も無効化 -->
        <PublishAot>false</PublishAot>
        <ApplicationIcon>TwitterIcon48.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AssemblyName>WinUI 3  Twitter</AssemblyName>
        <AssemblyTitle>WinUI 3  Twitter</AssemblyTitle>
    </PropertyGroup>
</Project>
